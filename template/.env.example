# Chain — defaults to Rome Hadrian (200010), resolved from @rome-protocol/registry.
# Override the RPCs only if you have your own (e.g. a private Solana RPC).
# CHAIN_ID=200010
PROXY_URL=
SOLANA_RPC=

# EVM lane wallet (a MetaMask-style key). Needs USDC as its Rome gas balance —
# bridge USDC into Rome (there is no faucet). Used to deploy the Vault + drive the EVM lane.
EVM_KEY=0xYOUR_EVM_PRIVATE_KEY

# Solana lane wallet (a Phantom-style key, as the JSON secret-key array Phantom/solana-keygen export).
# Needs a little SOL (tx fees) + USDC (the value it deposits).
SOLANA_KEY=[1,2,3]

# Set this after `npm run deploy` (or the demo deploys its own).
VAULT_ADDRESS=
